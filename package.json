{
  "name": "agent-manager",
  "version": "0.3.1",
  "private": true,
  "files": [
    "dist/chunk-*.js",
    "dist/cli/index.js",
    "dist/discovery/worker.js",
    "dist/server/index.js",
    "dist/web/apple-touch-icon-180x180.png",
    "dist/web/assets/index-*.css",
    "dist/web/assets/index-*.js",
    "dist/web/assets/workbox-window.prod.es5-*.js",
    "dist/web/favicon.ico",
    "dist/web/favicon.svg",
    "dist/web/fonts/ibm-plex-mono-400-latin.woff2",
    "dist/web/fonts/ibm-plex-mono-500-latin.woff2",
    "dist/web/fonts/instrument-sans-latin.woff2",
    "dist/web/fonts/LICENSE",
    "dist/web/fonts/LICENSE-IBM-Plex-Mono.txt",
    "dist/web/fonts/LICENSE-Instrument-Sans.txt",
    "dist/web/icon.svg",
    "dist/web/index.html",
    "dist/web/manifest.webmanifest",
    "dist/web/maskable-icon-512x512.png",
    "dist/web/pwa-64x64.png",
    "dist/web/pwa-192x192.png",
    "dist/web/pwa-512x512.png",
    "dist/web/sw.js",
    "README.md",
    "SECURITY.md"
  ],
  "type": "module",
  "description": "Local cockpit for discovering and managing Codex and Claude agent sessions.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "agent-manager": "dist/cli/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "fastify": "5.11.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@assistant-ui/react": "0.15.2",
    "@assistant-ui/react-markdown": "0.14.8",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "clsx": "2.1.1",
    "concurrently": "10.0.4",
    "jsdom": "30.0.1",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "tailwindcss": "4.3.3",
    "tailwind-merge": "3.6.0",
    "tsup": "8.5.1",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "generate:pwa-assets": "pwa-assets-generator --root web --config src/pwa/pwa-assets.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsup --config tsup.config.ts",
    "build:web": "tsx scripts/build-web.ts",
    "deploy": "pnpm build && node dist/cli/index.js service install && node dist/cli/index.js open",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:build-web",
    "typecheck:build-web": "tsc --ignoreConfig --noEmit --target ES2024 --module ESNext --moduleResolution Bundler --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --allowImportingTsExtensions --skipLibCheck --types node scripts/build-id.ts scripts/build-web.ts scripts/build-web.test.ts scripts/verify-cutover.ts scripts/verify-cutover.test.ts scripts/verify-hooks-e2e.ts scripts/verify-hooks-e2e.test.ts",
    "test": "node --test --experimental-strip-types scripts/build-id.test.ts scripts/build-web.test.ts scripts/verify-cutover.test.ts scripts/verify-hooks-e2e.test.ts $(find src -name '*.test.ts' -print)",
    "test:web": "vitest run --config web/vitest.config.ts",
    "verify:cutover": "tsx scripts/verify-cutover.ts",
    "verify:hooks-e2e": "tsx scripts/verify-hooks-e2e.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:web && pnpm build && pnpm verify:cutover"
  }
}
