{
  "name": "agent-manager",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Local cockpit for discovering and managing Codex and Claude agent sessions.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "agent-manager": "dist/cli/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@assistant-ui/react": "0.15.2",
    "@assistant-ui/react-markdown": "0.14.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.2",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.11.2",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vite-pwa/assets-generator": "1.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "concurrently": "10.0.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsup": "8.5.1",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "generate:pwa-assets": "pwa-assets-generator --root web --config src/pwa/pwa-assets.config.ts",
    "build": "pnpm build:server && pnpm build:web",
    "build:server": "tsup --config tsup.config.ts",
    "build:web": "tsx scripts/build-web.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:build-web",
    "typecheck:build-web": "tsc --ignoreConfig --noEmit --target ES2024 --module ESNext --moduleResolution Bundler --strict --noUncheckedIndexedAccess --exactOptionalPropertyTypes --allowImportingTsExtensions --skipLibCheck --types node scripts/build-web.ts scripts/build-web.test.ts",
    "test": "node --test --experimental-strip-types agent-sessions.test.ts scripts/build-web.test.ts $(find src -name '*.test.ts' -print)",
    "test:web": "vitest run --config web/vitest.config.ts",
    "check": "pnpm typecheck && pnpm test && pnpm test:web && pnpm build"
  }
}
